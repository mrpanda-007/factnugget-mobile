{
  "name": "kids-discovery",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "57.0.9",
    "expo-asset": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-iap": "^5.3.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:firestore-rules": "firebase emulators:exec --project factnuggets-phase9e --only auth,firestore \"FIRESTORE_EMULATOR_TEST=true vitest run tests/firestoreRules.test.ts\"",
    "test:phase9f": "npm --prefix functions run build && firebase emulators:exec --project factnuggets-phase9f --only auth,firestore,functions \"FIRESTORE_EMULATOR_TEST=true FUNCTIONS_EMULATOR_TEST=true vitest run tests/familyBootstrapFunctions.test.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-factnuggets-phase11b --only auth,firestore,functions \"PHASE11B_EMULATOR_TEST=true vitest run tests/e2e\"",
    "test:phase11b": "npm --prefix functions run build && npm run test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "private": true
}
