# Copy this file to .env and fill in values as needed.
#
# Expo inlines any EXPO_PUBLIC_ prefixed variable into the client bundle at
# build time — no extra library required (see 00-tech-stack.md Library
# Policy: "prefer platform/native capability over a third-party package").
# Because these are bundled into the client, EXPO_PUBLIC_ vars must never
# hold secrets (11-coding-standards.md "No secrets inside source code").
#
# Firebase client configuration is optional. Parent Auth is unavailable when
# the required values are absent; child exploration and local SQLite continue.
# These are client-visible identifiers, never Admin SDK/service-account secrets.

EXPO_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Firebase — optional parent Auth foundation (Phase 9C)
# ---------------------------------------------------------------------------
# Register a Firebase web app in the development/staging/production Firebase
# project that matches EXPO_PUBLIC_APP_ENV. Do not point a production build at
# a development project. Firebase Auth uses AsyncStorage internally for its
# own session persistence; this app does not manually persist Auth tokens.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Content source
# ---------------------------------------------------------------------------
# 'mock'   — bundled content in services/mock/ (default). Works offline, with
#            no .env and no published content.
# 'sanity' — live content from the Studio in ../studio-factnuggets.
#
# ⚠️ 'sanity' currently reads straight from the CDN. The SQLite offline cache
# (06-content-sync-engine.md) is not built yet, so this is a development mode,
# not a shippable one.
EXPO_PUBLIC_CONTENT_SOURCE=mock

# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
# Safe to expose: the project id and dataset name identify a *public, read-only*
# CDN endpoint. They are not credentials. Never add a Sanity write token here —
# an EXPO_PUBLIC_ token ships inside the app bundle and can be extracted from
# any installed copy.
EXPO_PUBLIC_SANITY_PROJECT_ID=bhgo6qa7
EXPO_PUBLIC_SANITY_DATASET=production
