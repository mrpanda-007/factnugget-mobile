{
  "expo": {
    "name": "FactNuggets",
    "slug": "kids-discovery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/factnuggets-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.factnuggets.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3AAAE1",
        "foregroundImage": "./assets/images/factnuggets-android-foreground.png",
        "backgroundImage": "./assets/images/factnuggets-android-background.png",
        "monochromeImage": "./assets/images/factnuggets-android-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.factnuggets.app"
    },
    "web": {
      "favicon": "./assets/images/factnuggets-favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      "expo-iap",
      "./plugins/withAndroidBackupPolicy",
      "./plugins/withAndroidReleaseSigning"
    ]
  }
}
